// Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon) used by the application at runtime.
  url       = env("DATABASE_URL")
  // Direct connection used for migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  googleId      String?   @unique
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  USER
  ADMIN
}

// Example model — remove or adapt to your needs.
model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Verze/buildy aplikace a jejich changelog.
model SbbApp {
  id          Int      @id @default(autoincrement())
  build       String
  versionCode Int?     @map("version_code")
  datum       DateTime @default(now())
  popisZmen   String?  @map("popis_zmen")
  // Odkaz na APK soubor (ukládaný do složky "Soubory").
  apkUrl      String?  @map("apk_url")

  @@map("SBB_apps")
}
