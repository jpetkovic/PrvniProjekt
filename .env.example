# Neon Postgres connection strings.
# Get these from the Neon dashboard: https://console.neon.tech/
#
# DATABASE_URL  -> pooled connection (used by the app at runtime, has -pooler in the host)
# DIRECT_URL    -> direct connection (used by Prisma Migrate)

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Secret used to sign session cookies (generate: openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-random-32-byte-hex-string"

# E-mail (Gmail SMTP) — bez GMAIL_APP_PASSWORD se ověřovací odkaz jen vypíše do konzole
# GMAIL_APP_PASSWORD je 16místné "App password" z https://myaccount.google.com/apppasswords
# (vyžaduje zapnuté dvoufázové ověření na účtu), NE běžné heslo k účtu.
GMAIL_USER="petkovic.jiri@gmail.com"
GMAIL_APP_PASSWORD=""
EMAIL_FROM="PrvniProjekt <petkovic.jiri@gmail.com>"
